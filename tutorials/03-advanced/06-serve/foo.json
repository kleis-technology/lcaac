{
  "openapi": "3.0.3",
  "info": {
    "title": "cloud-assess",
    "version": "1.0.0",
    "description": "Impacts of cloud resources"
  },
  "paths": {
    "/virtual_machine": {
      "post": {
        "operationId": "virtual_machine",
        "summary": "Impacts of one hour of a virtual machine",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VirtualMachineRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirtualMachineResponse"
                }
              }
            }
          },
          "400": {
            "description": "A value of the request cannot be read, or has the wrong dimension",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The evaluation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/vm_fleet": {
      "post": {
        "operationId": "vm_fleet",
        "summary": "Impacts of a fleet of virtual machines",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VmFleetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VmFleetResponse"
                }
              }
            }
          },
          "400": {
            "description": "A value of the request cannot be read, or has the wrong dimension",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The evaluation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VirtualMachineRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vcpu": {
            "allOf": [
              {
                "$ref": "#/components/schemas/QuantityInput"
              }
            ],
            "description": "Number of virtual CPUs Quantity of dimension none. Default unit u.",
            "default": "2.0 u"
          },
          "region": {
            "type": "string",
            "default": "FR"
          }
        }
      },
      "VirtualMachineResponse": {
        "type": "object",
        "required": [
          "impacts",
          "electricity"
        ],
        "properties": {
          "impacts": {
            "type": "array",
            "description": "One element per matching row of the trace.",
            "items": {
              "type": "object",
              "required": [
                "GWP"
              ],
              "properties": {
                "GWP": {
                  "$ref": "#/components/schemas/Quantity"
                }
              }
            }
          },
          "electricity": {
            "type": "array",
            "description": "One element per matching row of the trace.",
            "items": {
              "type": "object",
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "$ref": "#/components/schemas/Quantity"
                }
              }
            }
          }
        }
      },
      "VmFleetVmsRow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "default": "vm-001"
          },
          "vcpu": {
            "allOf": [
              {
                "$ref": "#/components/schemas/QuantityInput"
              }
            ],
            "description": "Quantity of dimension none. Default unit u.",
            "default": "2.0 u"
          },
          "hours": {
            "allOf": [
              {
                "$ref": "#/components/schemas/QuantityInput"
              }
            ],
            "description": "Quantity of dimension time. Default unit hour.",
            "default": "720.0 hour"
          },
          "region": {
            "type": "string",
            "default": "FR"
          }
        }
      },
      "VmFleetRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vms": {
            "type": "array",
            "description": "The virtual machines of the fleet",
            "items": {
              "$ref": "#/components/schemas/VmFleetVmsRow"
            }
          }
        }
      },
      "VmFleetResponse": {
        "type": "object",
        "required": [
          "total",
          "per_vm",
          "electricity"
        ],
        "properties": {
          "total": {
            "type": "array",
            "description": "One element per matching row of the trace.",
            "items": {
              "type": "object",
              "required": [
                "GWP"
              ],
              "properties": {
                "GWP": {
                  "$ref": "#/components/schemas/Quantity"
                }
              }
            }
          },
          "per_vm": {
            "type": "array",
            "description": "One element per matching row of the trace.",
            "items": {
              "type": "object",
              "required": [
                "arguments",
                "amount",
                "GWP"
              ],
              "properties": {
                "arguments": {
                  "$ref": "#/components/schemas/Strings"
                },
                "amount": {
                  "$ref": "#/components/schemas/Quantity"
                },
                "GWP": {
                  "$ref": "#/components/schemas/Quantity"
                }
              }
            }
          },
          "electricity": {
            "type": "array",
            "description": "One element per matching row of the trace.",
            "items": {
              "type": "object",
              "required": [
                "arguments",
                "amount",
                "GWP"
              ],
              "properties": {
                "arguments": {
                  "$ref": "#/components/schemas/Strings"
                },
                "amount": {
                  "$ref": "#/components/schemas/Quantity"
                },
                "GWP": {
                  "$ref": "#/components/schemas/Quantity"
                }
              }
            }
          }
        }
      },
      "QuantityInput": {
        "description": "Text in the language syntax (\"4 u\"), a number in the default unit, or an amount with a unit.",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "$ref": "#/components/schemas/Quantity"
          }
        ]
      },
      "Quantity": {
        "type": "object",
        "required": [
          "amount",
          "unit"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "Strings": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "ErrorFrame": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorFrame"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorFrame"
            }
          }
        }
      }
    }
  }
}
